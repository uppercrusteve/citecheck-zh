    given-names: Yilong
    email: YilongXiao@users.noreply.github.com
version: 0.1.0
date-released: 2026-11-17
license: MIT
repository-code: https://github.com/YilongXiao/citecheck-zh
url: https://github.com/YilongXiao/citecheck-zh
keywords:
  - citations
  - references
  - chinese
  - manuscript
  - cli
  - reproducibility
